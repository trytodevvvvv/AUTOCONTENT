{
  "name": "autocontent-ai",
  "version": "1.1.5",
  "description": "Auto Content Scriptwriter Desktop App with Multi-Provider AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:setup": "electron-builder --win nsis",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.autocontent.studio",
    "productName": "AutoContent Studio",
    "copyright": "Copyright © 2026 AutoContent Studio",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "trytodevvvvv",
      "repo": "AUTOCONTENT"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "saved_apis.example.json",
      "assets/**/*",
      "renderer/**/*",
      "!saved_apis.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutoContent Studio"
    },
    "portable": {
      "artifactName": "AutoContent-Studio-Portable-v${version}.${ext}"
    }
  },
  "keywords": [
    "youtube",
    "content-creator",
    "ai-scriptwriter",
    "electron",
    "deepseek",
    "openrouter"
  ],
  "author": "AutoContent AI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
